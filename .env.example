# Copiare in .env (escluso dal versionamento) e compilare.
# Nessun valore reale va scritto in questo file.

# Database della dashboard.
# L'utente applicativo deve avere solo SELECT, INSERT, UPDATE:
# non deve poter modificare lo schema ne' cancellare righe.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=osservatorio_promo
DB_USER=
DB_PASSWORD=

# Da dove pende l'applicazione dentro il dominio.
# Vuoto (o assente) = sta alla radice:        https://esempio.it/
# Altrimenti il prefisso, con la barra davanti e senza quella finale:
#   APP_BASE_PATH=/promosupermercati          https://esempio.it/promosupermercati
# Deve corrispondere a come il server web la espone, altrimenti si gira a vuoto
# fra la pagina di accesso e le altre.
APP_BASE_PATH=
